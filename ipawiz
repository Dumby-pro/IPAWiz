#!/usr/bin/env python3
"""
IPAWiz - CLI tool for building iPhone IPA apps on Linux.

Wraps Theos to provide a simple interface for:
  - Installing the iOS build toolchain
  - Packaging an existing .app bundle into an IPA
  - Wrapping a folder of web files (HTML/CSS/JS) into a WKWebView-backed IPA

The resulting IPAs are unsigned. Sideload with SideStore / AltStore / Feather /
TrollStore (which will sign them on-device), or sign yourself with zsign + a
.p12 + .mobileprovision (install via `ipawiz --setup --sign`).
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

VERSION = "0.1.0"
THEOS_DIR = Path.home() / "theos"
IPAWIZ_DIR = Path.home() / ".ipawiz"


# ---------- output helpers ----------

class C:
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    RED = "\033[91m"
    CYAN = "\033[96m"
    DIM = "\033[2m"
    BOLD = "\033[1m"
    END = "\033[0m"


def _supports_color():
    return sys.stdout.isatty() and os.environ.get("TERM") != "dumb"


def _fmt(color, msg):
    return f"{color}{msg}{C.END}" if _supports_color() else msg


def info(msg):    print(_fmt(C.CYAN,   f"[*] {msg}"))
def good(msg):    print(_fmt(C.GREEN,  f"[+] {msg}"))
def warn(msg):    print(_fmt(C.YELLOW, f"[!] {msg}"))
def err(msg):     print(_fmt(C.RED,    f"[x] {msg}"), file=sys.stderr)
def dim(msg):     print(_fmt(C.DIM,    f"    {msg}"))


def die(msg, code=1):
    err(msg)
    sys.exit(code)


def run(cmd, **kwargs):
    """Run a subprocess; raise on failure with a clear message."""
    dim("$ " + " ".join(str(c) for c in cmd))
    result = subprocess.run(cmd, **kwargs)
    if result.returncode != 0:
        die(f"Command failed: {' '.join(str(c) for c in cmd)}")
    return result


# ---------- setup ----------

APT_DEPS = [
    "build-essential", "fakeroot", "curl", "perl", "git",
    "rsync", "libxml2-utils", "libplist-utils", "libplist-dev",
    "zip", "unzip", "cmake", "pkg-config", "libssl-dev",
]

PACMAN_DEPS = [
    "base-devel", "fakeroot", "curl", "perl", "git",
    "rsync", "libxml2", "libplist", "zip", "unzip",
    "cmake", "pkgconf", "openssl",
]

DNF_DEPS = [
    "@development-tools", "fakeroot", "curl", "perl", "git",
    "rsync", "libxml2", "libplist", "libplist-devel", "zip", "unzip",
    "cmake", "pkgconfig", "openssl-devel",
]


def detect_pkg_manager():
    for mgr in ("apt", "dnf", "pacman", "zypper"):
        if shutil.which(mgr):
            return mgr
    return None


def install_system_deps():
    mgr = detect_pkg_manager()
    if mgr == "apt":
        info("Installing apt dependencies...")
        run(["sudo", "apt-get", "update"])
        run(["sudo", "apt-get", "install", "-y", *APT_DEPS])
    elif mgr == "dnf":
        info("Installing dnf dependencies...")
        run(["sudo", "dnf", "install", "-y", *DNF_DEPS])
    elif mgr == "pacman":
        info("Installing pacman dependencies...")
        run(["sudo", "pacman", "-Sy", "--needed", "--noconfirm", *PACMAN_DEPS])
    else:
        die("No supported package manager found (apt/dnf/pacman). Install build deps manually.")


def install_ldid():
    """ldid does pseudo-signing required by the iOS build. Try apt, else build from source."""
    if shutil.which("ldid"):
        good("ldid already installed")
        return

    if detect_pkg_manager() == "apt":
        info("Trying to install ldid via apt...")
        r = subprocess.run(["sudo", "apt-get", "install", "-y", "ldid"])
        if r.returncode == 0 and shutil.which("ldid"):
            good("Installed ldid via apt")
            return
        warn("apt couldn't install ldid; building from source instead")

    info("Building ldid from source (ProcursusTeam fork)...")
    src = IPAWIZ_DIR / "src" / "ldid"
    src.parent.mkdir(parents=True, exist_ok=True)
    if not src.exists():
        run(["git", "clone", "--recursive",
             "https://github.com/ProcursusTeam/ldid.git", str(src)])
    run(["make", "-j", str(os.cpu_count() or 2)], cwd=src)
    bin_dst = Path.home() / ".local" / "bin"
    bin_dst.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src / "ldid", bin_dst / "ldid")
    good(f"Installed ldid to {bin_dst / 'ldid'}")


def install_theos():
    if THEOS_DIR.exists() and (THEOS_DIR / "makefiles").exists():
        good(f"Theos already installed at {THEOS_DIR}")
        return
    info(f"Cloning Theos to {THEOS_DIR}...")
    run(["git", "clone", "--recursive",
         "https://github.com/theos/theos.git", str(THEOS_DIR)])


TOOLCHAIN_URL = (
    "https://github.com/sbingner/llvm-project/releases/latest/download/"
    "linux-ios-arm64e-clang-toolchain.tar.lzma"
)


def install_toolchain():
    """Install the Linux->iOS cross-compiler clang toolchain Theos needs.

    Theos itself does not bundle a toolchain; without one, builds fail with
    'No such file or directory' on $THEOS/toolchain/linux/iphone/bin/clang.
    We install sbingner's arm64e toolchain, which is the toolchain currently
    recommended by the Theos wiki for Linux.
    """
    tc_dir = THEOS_DIR / "toolchain" / "linux" / "iphone"
    if (tc_dir / "bin" / "clang").exists():
        good("Theos toolchain already installed")
        return
    info("Downloading iOS cross-compiler toolchain (~200MB)...")
    IPAWIZ_DIR.mkdir(exist_ok=True)
    tarball = IPAWIZ_DIR / "linux-ios-arm64e-clang-toolchain.tar.lzma"
    run(["curl", "-fL", "-o", str(tarball), TOOLCHAIN_URL])
    tc_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        # GNU tar handles .lzma with --lzma; BSD tar with -J only handles xz.
        run(["tar", "--lzma", "-xf", str(tarball), "-C", tmp])
        # Archive layout: ios-arm64e-clang-toolchain/{bin,lib,...}
        candidates = [p for p in Path(tmp).iterdir() if p.is_dir()]
        if not candidates:
            die("Toolchain archive contained no directories; layout unexpected.")
        src = candidates[0]
        for item in src.iterdir():
            shutil.move(str(item), str(tc_dir / item.name))
    try:
        tarball.unlink()
    except OSError:
        pass
    good(f"Installed toolchain to {tc_dir}")
    _verify_toolchain(tc_dir)


def _verify_toolchain(tc_dir):
    """Run `clang --version` to surface load-time errors at setup time.

    The sbingner toolchain links against libtinfo.so.5, which has been
    dropped from Ubuntu 24.04's default repos. Catching this here lets us
    print a clear pointer instead of letting users hit a cryptic
    'shared library not found' error on their first build.
    """
    clang = tc_dir / "bin" / "clang"
    if not clang.exists():
        return
    try:
        r = subprocess.run([str(clang), "--version"],
                           capture_output=True, text=True)
    except OSError as e:
        warn(f"Could not run clang sanity check: {e}")
        return
    if r.returncode == 0:
        return
    err = (r.stderr or "") + (r.stdout or "")
    if "libtinfo.so.5" in err:
        warn("Toolchain clang requires libtinfo.so.5, dropped from Ubuntu 24.04+ default repos.")
        warn("Fix it by grabbing the jammy package — current URL (verify at https://packages.ubuntu.com/libtinfo5):")
        dim("  wget http://security.ubuntu.com/ubuntu/pool/universe/n/ncurses/"
            "libtinfo5_6.3-2ubuntu0.1_amd64.deb")
        dim("  sudo apt install ./libtinfo5_6.3-2ubuntu0.1_amd64.deb")
        warn("On older Debian/Ubuntu (focal, jammy): `sudo apt install libtinfo5`.")
    else:
        warn(f"Toolchain clang sanity check failed:\n{err.strip()}")


def install_ios_sdk():
    sdks_dir = THEOS_DIR / "sdks"
    sdks_dir.mkdir(exist_ok=True)
    if any(sdks_dir.glob("iPhoneOS*.sdk")):
        good("iOS SDK already present")
        return
    info("Downloading iOS SDK from theos/sdks (this is large, ~600MB)...")
    tmp = sdks_dir / "_clone"
    if tmp.exists():
        shutil.rmtree(tmp)
    run(["git", "clone", "--depth=1",
         "https://github.com/theos/sdks.git", str(tmp)])
    moved = 0
    for sdk in tmp.glob("iPhoneOS*.sdk"):
        shutil.move(str(sdk), str(sdks_dir / sdk.name))
        moved += 1
    shutil.rmtree(tmp)
    if moved == 0:
        die("No iPhoneOS SDKs found in theos/sdks. Check the repo manually.")
    good(f"Installed {moved} iOS SDK(s)")


def install_zsign():
    if shutil.which("zsign"):
        good("zsign already installed")
        return
    info("Building zsign from source...")
    src = IPAWIZ_DIR / "src" / "zsign"
    src.parent.mkdir(parents=True, exist_ok=True)
    if not src.exists():
        run(["git", "clone", "--depth=1",
             "https://github.com/zhlynn/zsign.git", str(src)])
    build = src / "build"
    build.mkdir(exist_ok=True)
    run(["cmake", ".."], cwd=build)
    run(["make", "-j", str(os.cpu_count() or 2)], cwd=build)
    bin_dst = Path.home() / ".local" / "bin"
    bin_dst.mkdir(parents=True, exist_ok=True)
    shutil.copy2(build / "zsign", bin_dst / "zsign")
    good(f"Installed zsign to {bin_dst / 'zsign'}")


def write_shell_env():
    line = f'export THEOS="{THEOS_DIR}"'
    for rc in (".bashrc", ".zshrc"):
        p = Path.home() / rc
        if not p.exists():
            continue
        content = p.read_text()
        if 'THEOS=' in content:
            continue
        with p.open("a") as f:
            f.write(f"\n# Added by IPAWiz\n{line}\n")
        info(f"Added THEOS export to ~/{rc}")


def cmd_setup(args):
    info("Setting up IPAWiz build environment...")
    IPAWIZ_DIR.mkdir(exist_ok=True)

    install_system_deps()
    install_ldid()
    install_theos()
    install_toolchain()
    install_ios_sdk()
    if args.sign:
        install_zsign()
    write_shell_env()

    good("Setup complete.")
    info("Open a new terminal (or run `source ~/.bashrc`) so $THEOS is set.")
    if args.sign:
        dim("To sign: ipawiz <folder> --sign-p12 cert.p12 --sign-pp profile.mobileprovision")


# ---------- packaging ----------

def make_ipa(app_bundle: Path, output: Path):
    """Zip an .app into a proper IPA structure (Payload/<App>.app at root)."""
    if output.exists():
        output.unlink()

    with tempfile.TemporaryDirectory() as tmp:
        payload = Path(tmp) / "Payload"
        payload.mkdir()
        shutil.copytree(app_bundle, payload / app_bundle.name, symlinks=True)

        with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED) as zf:
            for root, _dirs, files in os.walk(payload.parent):
                for f in files:
                    full = Path(root) / f
                    arc = full.relative_to(tmp)
                    zf.write(full, arc)
    return output


def find_app_bundle(path: Path):
    """Locate a .app directory at `path` or one level inside it."""
    if path.is_dir() and path.suffix == ".app":
        return path
    if path.is_dir():
        candidates = list(path.glob("*.app"))
        if candidates:
            return candidates[0]
        for child in path.iterdir():
            if child.is_dir() and child.suffix == ".app":
                return child
    return None


def maybe_sign(app_bundle: Path, args):
    if not (args.sign_p12 or args.sign_pp):
        return
    if not (args.sign_p12 and args.sign_pp):
        die("Signing needs both --sign-p12 and --sign-pp")
    if not shutil.which("zsign"):
        die("zsign not found. Re-run setup with: ipawiz --setup --sign")

    info("Signing with zsign...")
    cmd = ["zsign", "-k", args.sign_p12, "-m", args.sign_pp]
    if args.sign_password:
        cmd += ["-p", args.sign_password]
    cmd.append(str(app_bundle))
    run(cmd)
    good("Signed.")


def cmd_folder(args):
    folder = Path(args.folder).resolve()
    if not folder.exists():
        die(f"Not found: {folder}")

    app = find_app_bundle(folder)
    if app is None:
        die(
            f"No .app bundle in {folder}.\n"
            "    Expected either an .app directory or a folder containing one.\n"
            "    To wrap a web folder instead, use:  ipawiz --web <folder>"
        )

    maybe_sign(app, args)

    out = Path(args.output) if args.output else Path.cwd() / f"{app.stem}.ipa"
    info(f"Packaging {app.name} -> {out}")
    make_ipa(app, out)
    good(f"Wrote {out}")


